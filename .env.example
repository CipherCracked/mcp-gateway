# Secure MCP Gateway — local environment
# Copy this file to .env and fill in your own values. .env is gitignored.

# OpenRouter API key for frontier model evaluations (never commit this)
LLM_API_KEY=sk-or-...

# Optional: model override for `npm run generate`
# Defaults to openrouter/nvidia/nemotron-3.5-lightning:free
OH_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free

# Optional: which code to score ('reference' or 'workspace')
# Defaults to 'workspace'
GATEWAY_MODULE=workspace.mcp_gateway.main:app
